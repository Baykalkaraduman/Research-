   "source": [
    "def Fibonacci(n):\n",
    "    # starting values\n",
    "    a = 0\n",
    "    b = 1\n",
    "    # loop\n",
    "    for i in range(1, n):\n",
    "        c = a + b\n",
    "        a = b\n",
    "        b = c\n",
    "    return c\n",
    "    \n",
    "n = 20\n",
    "print(Fibonacci(n))"
   ]
